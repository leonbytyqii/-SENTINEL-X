<!-- SENTINEL-X – Custom Wazuh Detection Rules -->
<!--
  Rule ID range: 100001–100099 (custom range, no conflict with built-in rules)
  Severity scale: 1-15 (Wazuh) — 7+ generates alerts, 12+ critical
-->

<group name="sentinel-x,web,">

  <!-- ═══════════════════════════════════════════════════════════════════
       NGINX ACCESS LOG RULES
       ═══════════════════════════════════════════════════════════════════ -->

  <!-- Base rule: any nginx access log event -->
  <rule id="100001" level="0">
    <decoded_as>sentinel-nginx-access</decoded_as>
    <description>SENTINEL-X: NGINX access log event</description>
    <group>nginx,</group>
  </rule>

  <!-- HTTP 4xx errors (client errors) -->
  <rule id="100002" level="3">
    <if_sid>100001</if_sid>
    <field name="status">^4\d\d$</field>
    <description>SENTINEL-X: NGINX HTTP 4xx client error from $(srcip)</description>
    <group>nginx,http_error,</group>
  </rule>

  <!-- HTTP 5xx errors (server errors) -->
  <rule id="100003" level="5">
    <if_sid>100001</if_sid>
    <field name="status">^5\d\d$</field>
    <description>SENTINEL-X: NGINX HTTP 5xx server error</description>
    <group>nginx,http_error,server_error,</group>
  </rule>

  <!-- Suspicious HTTP method -->
  <rule id="100004" level="6">
    <if_sid>100001</if_sid>
    <field name="protocol">^(CONNECT|TRACE|TRACK)$</field>
    <description>SENTINEL-X: Suspicious HTTP method $(protocol) from $(srcip)</description>
    <group>nginx,web_attack,suspicious_method,</group>
  </rule>

  <!-- Brute-force: 10 x 4xx from same IP in 60s -->
  <rule id="100005" level="10" frequency="10" timeframe="60">
    <if_matched_sid>100002</if_matched_sid>
    <same_field>srcip</same_field>
    <description>SENTINEL-X: Repeated HTTP errors from $(srcip) — possible scanner/brute-force</description>
    <group>nginx,web_attack,brute_force,</group>
    <mitre>
      <id>T1595</id>
    </mitre>
  </rule>

  <!-- HTTP scanning (TRACE/OPTIONS flood) -->
  <rule id="100006" level="8" frequency="5" timeframe="30">
    <if_matched_sid>100004</if_matched_sid>
    <same_field>srcip</same_field>
    <description>SENTINEL-X: HTTP scanning detected from $(srcip)</description>
    <group>nginx,web_attack,scanning,</group>
    <mitre>
      <id>T1595.001</id>
    </mitre>
  </rule>

  <!-- ═══════════════════════════════════════════════════════════════════
       MODSECURITY AUDIT LOG RULES
       ═══════════════════════════════════════════════════════════════════ -->

  <!-- Base rule: any ModSecurity audit event -->
  <rule id="100010" level="5">
    <decoded_as>sentinel-modsecurity</decoded_as>
    <description>SENTINEL-X: ModSecurity WAF event from $(srcip)</description>
    <group>modsecurity,waf,</group>
  </rule>

  <!-- WAF blocked request (HTTP 403) -->
  <rule id="100011" level="8">
    <if_sid>100010</if_sid>
    <field name="status">^403$</field>
    <description>SENTINEL-X: ModSecurity BLOCKED request from $(srcip) — $(url)</description>
    <group>modsecurity,waf,blocked,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- SQL Injection (CRS rule IDs 942xxx) -->
  <rule id="100020" level="12">
    <decoded_as>sentinel-modsecurity</decoded_as>
    <field name="transaction.messages.message">942\d\d\d</field>
    <description>SENTINEL-X: SQL Injection attempt detected by WAF from $(srcip)</description>
    <group>modsecurity,waf,web_attack,sql_injection,</group>
    <mitre>
      <id>T1190</id>
      <id>T1059.007</id>
    </mitre>
  </rule>

  <!-- Cross-Site Scripting (CRS rule IDs 941xxx) -->
  <rule id="100021" level="10">
    <decoded_as>sentinel-modsecurity</decoded_as>
    <field name="transaction.messages.message">941\d\d\d</field>
    <description>SENTINEL-X: XSS attempt detected by WAF from $(srcip)</description>
    <group>modsecurity,waf,web_attack,xss,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- Local File Inclusion (CRS rule IDs 930xxx) -->
  <rule id="100022" level="11">
    <decoded_as>sentinel-modsecurity</decoded_as>
    <field name="transaction.messages.message">930\d\d\d</field>
    <description>SENTINEL-X: LFI attempt detected by WAF from $(srcip) — $(url)</description>
    <group>modsecurity,waf,web_attack,lfi,</group>
    <mitre>
      <id>T1190</id>
      <id>T1083</id>
    </mitre>
  </rule>

  <!-- Path Traversal — common in LFI rule group -->
  <rule id="100023" level="10">
    <decoded_as>sentinel-modsecurity</decoded_as>
    <field name="transaction.request.uri">\.\.\/|\.\.\\</field>
    <description>SENTINEL-X: Path traversal pattern in request URI from $(srcip)</description>
    <group>modsecurity,waf,web_attack,path_traversal,</group>
    <mitre>
      <id>T1190</id>
      <id>T1083</id>
    </mitre>
  </rule>

  <!-- Remote Code Execution signatures (CRS rule IDs 932xxx) -->
  <rule id="100024" level="14">
    <decoded_as>sentinel-modsecurity</decoded_as>
    <field name="transaction.messages.message">932\d\d\d</field>
    <description>SENTINEL-X: CRITICAL – RCE signature detected by WAF from $(srcip)</description>
    <group>modsecurity,waf,web_attack,rce,critical,</group>
    <mitre>
      <id>T1190</id>
      <id>T1059</id>
    </mitre>
  </rule>

  <!-- Anomaly score exceeded (CRS rule 949110 / 980130) -->
  <rule id="100025" level="12">
    <decoded_as>sentinel-modsecurity</decoded_as>
    <field name="transaction.messages.message">949110|980130</field>
    <description>SENTINEL-X: WAF anomaly threshold exceeded from $(srcip) — multi-vector attack</description>
    <group>modsecurity,waf,web_attack,anomaly_score,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- Repeated WAF blocks from same IP (5 blocks in 2 minutes = active attacker) -->
  <rule id="100030" level="13" frequency="5" timeframe="120">
    <if_matched_sid>100011</if_matched_sid>
    <same_field>srcip</same_field>
    <description>SENTINEL-X: ALERT – Repeated WAF blocks from $(srcip) — active attack campaign</description>
    <group>modsecurity,waf,web_attack,persistent_attack,</group>
    <mitre>
      <id>T1190</id>
      <id>T1595</id>
    </mitre>
  </rule>

  <!-- ═══════════════════════════════════════════════════════════════════
       CORRELATED RULES
       ═══════════════════════════════════════════════════════════════════ -->

  <!-- High-severity WAF event: immediately alert regardless of frequency -->
  <rule id="100040" level="13">
    <if_sid>100020,100022,100024</if_sid>
    <description>SENTINEL-X: HIGH-SEVERITY web attack from $(srcip) — immediate investigation required</description>
    <group>sentinel-x,high_severity,correlation,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

</group>
