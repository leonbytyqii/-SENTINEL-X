# SENTINEL-X Environment Configuration
# Copy this file to .env and fill in values before first run.
# NEVER commit .env to source control.

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTIC_VERSION=8.15.3
ELASTIC_PASSWORD=changeme_elastic_lab

# ── Kibana ───────────────────────────────────────────────────────────────────
KIBANA_PASSWORD=changeme_kibana_lab

# ── Wazuh ────────────────────────────────────────────────────────────────────
WAZUH_VERSION=4.9.2
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=changeme_wazuh_api
WAZUH_REGISTRATION_PASSWORD=changeme_registration

# ── NGINX + ModSecurity ──────────────────────────────────────────────────────
MODSEC_RULE_ENGINE=DetectionOnly
# Set to "On" after validation testing is complete.
ANOMALY_INBOUND=5
ANOMALY_OUTBOUND=4
CRS_PARANOIA_LEVEL=1

# ── Application ──────────────────────────────────────────────────────────────
APP_PORT_INTERNAL=8080
NGINX_PORT=80

# ── Resource Limits (tune for your RAM) ─────────────────────────────────────
ES_JAVA_OPTS=-Xms1g -Xmx1g
